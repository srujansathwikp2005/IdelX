{
  "Version": "2012-10-17",
  "Comment": "Least-privilege policy for the identity that RUNS the IdleX playbooks. EC2 only: the deployment creates no S3 buckets and no IAM roles, so no S3 or IAM permissions are required.",
  "Statement": [
    {
      "Sid": "InventoryAndProvisioning",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeAddresses",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSecurityGroupRules"
      ],
      "Resource": "*",
      "Comment": "The Describe*Attribute actions are easy to miss: amazon.aws modules call them to converge state after a change, so omitting them makes provisioning fail AFTER resources are created, leaving them orphaned."
    },
    {
      "Sid": "ManageInstancesAndSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:AssociateIamInstanceProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerminateOnlyOurOwnInstances",
      "Comment": "Scoped by tag so a mistake here cannot destroy unrelated workloads in the account.",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "idlex"
        }
      }
    }
  ]
}