# {{ ansible_managed }}
# Rendered to {{ app_root }}/shared/.env — lives in shared/ so it survives
# every release and is never part of a git checkout.
#
# Values come from environment variables on the control node (see README
# "Secrets"). Nothing secret is stored in this repository.

PORT={{ backend_port }}
NODE_ENV=production
CLIENT_URL={{ client_url }}

MONGO_URI={{ mongo_uri }}

JWT_ACCESS_SECRET={{ jwt_access_secret }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret }}
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Object storage — credentials come from the EC2 instance profile, so no
# AWS keys appear in this file.
STORAGE_DRIVER=s3
S3_BUCKET={{ s3_bucket }}
AWS_REGION={{ aws_region }}
S3_PREFIX={{ s3_prefix }}
S3_SIGNED_URL_TTL={{ s3_signed_url_ttl }}
UPLOAD_DIR=../uploads

RENFLAIR_API_KEY={{ renflair_api_key | default('') }}

SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default(465) }}
SMTP_SECURE={{ smtp_secure | default('true') }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASS={{ smtp_pass | default('') }}
SMTP_FROM={{ smtp_from | default('') }}

RAZORPAY_KEY_ID={{ razorpay_key_id | default('') }}
RAZORPAY_KEY_SECRET={{ razorpay_key_secret | default('') }}
RAZORPAY_WEBHOOK_SECRET={{ razorpay_webhook_secret | default('') }}
RAZORPAY_ACCOUNT_NUMBER={{ razorpay_account_number | default('') }}
