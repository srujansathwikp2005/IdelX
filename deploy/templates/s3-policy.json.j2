{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteUploadPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::{{ s3_bucket }}/{{ s3_prefix }}/*"
    },
    {
      "Sid": "ListOnlyThisPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{ s3_bucket }}",
      "Condition": {
        "StringLike": { "s3:prefix": "{{ s3_prefix }}/*" }
      }
    }
  ]
}
